version: 1
installation: composer-example
source:
  mode: local
  path: composer-example
  branch: master
  poll_interval: 2s
state_dir: composer-example-state
age_key_file: composer-example.agekey
environments: [prod, stage]
docker: {}
reconcile:
  parallelism: 4
  git_timeout: 30s
  deploy_timeout: 5m
