map_hash_bucket_size 128;

map $cookie_composer_stage $environment_backend {
    default prod;
    "{{ .Secrets.stage_token }}" stage;
}

resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 2s;

upstream prod {
    zone prod 64k;
    server nginx-prod:8080 resolve;
}

upstream stage {
    zone stage 64k;
    server nginx-stage:8080 resolve;
}

server {
    listen 443 ssl;
    server_name {{ .Vars.tls.domain }};
    ssl_certificate /etc/letsencrypt/live/site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz { return 200 "ok\n"; }

    location / {
        proxy_pass http://$environment_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 504 =503 @unavailable;
    }

    location @unavailable { return 503; }
}
