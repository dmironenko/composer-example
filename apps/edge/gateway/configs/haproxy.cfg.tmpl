global
    log stdout format raw local0
    stats socket /runtime/haproxy.sock mode 600 level admin
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    mode http
    log global
    option httplog
    timeout connect 5s
    timeout client 30s
    timeout server 30s

resolvers docker
    nameserver dns 127.0.0.11:53
    hold valid 2s
    hold nx 2s
    hold obsolete 2s

frontend http
    bind :80
    http-request return status 200 content-type text/plain string ok if { path /healthz }
    acl challenge path_beg /.well-known/acme-challenge/
    http-request redirect prefix https://{{ .Vars.tls.domain }}:{{ .Vars.tls.https_port }} code 308 unless challenge
    use_backend certbot if challenge

frontend https
    bind :443 ssl crt /certificates/site.pem
    http-request set-header X-Forwarded-Proto https
    http-request set-header X-Forwarded-For %[src]
    acl stage req.cook(composer_stage) -m str {{ .Secrets.stage_token }}
    use_backend stage if stage
    default_backend prod
    option httpchk GET /healthz
    http-check expect status 200
    http-check expect hdr name X-Composer-Environment value -m str prod

backend certbot
    server certbot certbot:8080 resolvers docker init-addr none

backend prod
    option httpchk GET /healthz
    http-check expect status 200
    http-check expect hdr name X-Composer-Environment value -m str prod
    server-template nginx 1-10 nginx-prod:8080 check resolvers docker resolve-prefer ipv4 init-addr none

backend stage
    option httpchk GET /healthz
    http-check expect status 200
    http-check expect hdr name X-Composer-Environment value -m str stage
    server-template nginx 1-10 nginx-stage:8080 check resolvers docker resolve-prefer ipv4 init-addr none
