events {}

http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }

    resolver 127.0.0.11 valid=2s ipv6=off;

    upstream api {
        zone api 64k;
        server api-http:8080 resolve;
    }

    upstream web {
        zone web 64k;
        server web-http:8080 resolve;
    }

    server {
        listen 8080;
        absolute_redirect {{ .Vars.app.absolute_redirect }};
        add_header X-Composer-Environment {{ quote .Env }} always;
        add_header X-Config-Revision {{ quote .Vars.app.config_revision }} always;

        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_x_forwarded_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout {{ .Vars.app.proxy_read_timeout }};

        location = /healthz { return 200 'ok\n'; }

        location /api/ {
            proxy_pass http://api/;
        }

        location / {
            proxy_pass http://web/;
        }
    }
}
