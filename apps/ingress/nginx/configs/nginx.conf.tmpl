map_hash_bucket_size 128;

{{ $default := "" }}
{{ range .Environments }}{{ if eq . "prod" }}{{ $default = "env_prod" }}{{ end }}{{ end }}
map $cookie_composer_stage $environment_backend {
    default {{ quote $default }};
    "~^{{ .Secrets.stage_token }}:" "";
{{ range .Environments }}{{ if ne . "prod" }}
    "{{ $.Secrets.stage_token }}:{{ . }}" env_{{ . }};
{{ end }}{{ end }}
}

resolver 127.0.0.11 valid=2s ipv6=off;
resolver_timeout 2s;

{{ range .Environments }}
upstream env_{{ . }} {
    zone env_{{ . }} 64k;
    server nginx-{{ . }}:8080 resolve;
}
{{ end }}

server {
    listen 443 ssl;
    server_name {{ .Vars.tls.domain }};
    ssl_certificate /etc/letsencrypt/live/site/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/site/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /healthz { return 200 "ok\n"; }

    location / {
        if ($environment_backend = "") { return 503; }
        proxy_pass http://$environment_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 2s;
        proxy_read_timeout 30s;
        proxy_intercept_errors on;
        error_page 502 504 =503 @unavailable;
    }

    location @unavailable { return 503; }
}
